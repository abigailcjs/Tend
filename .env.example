# ──────────────────────────────────────────────────────────────
# Tend — environment variables
#
# Copy this file to `.env.local` and fill in the values from your
# Supabase project (Settings → API and Settings → Database).
#
# `.env.local` is gitignored — never commit real secrets.
# ──────────────────────────────────────────────────────────────

# Supabase project URL — e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (publishable) key. Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Direct Postgres connection string for Drizzle migrations + server-side
# queries. Use the "Connection pooling" string with `pgbouncer=true`
# and port 6543 for serverless / Edge environments.
#
# Format:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=
